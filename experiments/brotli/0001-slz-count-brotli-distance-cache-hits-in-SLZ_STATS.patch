On the HTML, only 12-14% of the references can use the cache even when
choosing cached distances on equal lengths, 3.3% of them on the last
distance alone. HTML repeats structures but not at constant distances.
The distance bits at stake are ~15 kB of a 260-305 kB output at 32 kB;
with short codes costing ~3 bits (9.5k hits = 3.6 kB), the net saving is
~4.5% of the output (11.8 kB of 260769 with -T). silesia does better
(18-23% of references) for a similar net saving (~5 MB of distance bits
at stake on 96 MB).
---
 src/slz.c | 102 +++++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 98 insertions(+), 4 deletions(-)

diff --git a/src/slz.c b/src/slz.c
index a26fb38..60b2e8f 100644
--- a/src/slz.c
+++ b/src/slz.c
@@ -327,7 +327,18 @@ static struct {
 	unsigned long long dist_hist[16];
 	unsigned long long hrun_hist[18];
 	unsigned long long srun_hist[18];
-} slz_stats;
+	/* brotli's distance cache (RFC7932 4.), see slz_stats_ref() */
+	uint32_t dcache[4];              /* last 4 distances, [0] = last */
+	unsigned long long dc_code[16];  /* references per short distance code */
+	unsigned long long dc_free;      /* code 0 with an implicit distance */
+	unsigned long long dc_bits;      /* fixed tree distance bits of the hits */
+	unsigned long long dc_switch;    /* misses where a cached distance gives the same length */
+	unsigned long long dc_short;     /* misses where it only gives a shorter match (>= 4) */
+	unsigned long long dc_short_lost;/* bytes these shorter ones would lose */
+	const unsigned char *base;       /* start of the current call's input */
+} slz_stats = { .dcache = { 4, 11, 15, 16 } };
+
+static inline long memmatch(const unsigned char *a, const unsigned char *b, long max);
 
 static inline int slz_stats_log2(unsigned long long v, int max)
 {
@@ -336,7 +347,7 @@ static inline int slz_stats_log2(unsigned long long v, int max)
 	return l < max ? l : max;
 }
 
-static inline void slz_stats_ref(uint32_t mlen, uint32_t dist, uint32_t bits, uint32_t lits)
+static inline void slz_stats_ref(uint32_t mlen, uint32_t dist, uint32_t bits, uint32_t lits, const unsigned char *p)
 {
 	slz_stats.refs++;
 	slz_stats.ref_len += mlen;
@@ -345,6 +356,63 @@ static inline void slz_stats_ref(uint32_t mlen, uint32_t dist, uint32_t bits, ui
 	slz_stats.ref_adj += !lits;
 	slz_stats.len_hist[mlen <= 8 ? (int)mlen - 3 : mlen == 258 ? 11 : slz_stats_log2(mlen - 1, 7) + 3]++;
 	slz_stats.dist_hist[slz_stats_log2(dist, 15)]++;
+
+	/* Brotli's distance cache: short codes 0-3 are the last 4 distances,
+	 * 4-9 the last one -1,+1,-2,+2,-3,+3 and 10-15 the same around the
+	 * second-to-last one. All codes but 0 push the distance in the ring.
+	 * Insert-and-copy codes 0-127 imply code 0 at no cost, they cover
+	 * insert lengths 0-9 and copy lengths 2-69. The ring is shared by all
+	 * calls, like a single stream. Code 16 means not in the cache.
+	 *
+	 * On a miss, the 16 cached distances are tried at the match's position
+	 * <p> to see if one of them gives the same length, in which case a
+	 * cache-aware encoder would have used it (it is counted as a switch,
+	 * and the ring follows that choice), or only a shorter match.
+	 */
+	{
+		static const signed char ofs[6] = { -1, 1, -2, 2, -3, 3 };
+		uint32_t *dc = slz_stats.dcache;
+		int code = 16, i;
+		long best = 0;
+
+		for (i = 0; i < 4 && code == 16; i++)
+			if (dist == dc[i])
+				code = i;
+		for (i = 0; i < 12 && code == 16; i++)
+			if (dist == dc[i / 6] + ofs[i % 6])
+				code = 4 + i;
+		for (i = 0; i < 16 && code == 16; i++) {
+			long cd = i < 4 ? (long)dc[i] : (long)dc[(i - 4) / 6] + ofs[(i - 4) % 6];
+			long l;
+
+			if (cd < 1 || cd > 32768 || cd > p - slz_stats.base)
+				continue;
+			l = memmatch(p, p - cd, mlen);
+			if (l == (long)mlen) {
+				code = i;
+				dist = cd;
+				slz_stats.dc_switch++;
+			}
+			else if (l > best)
+				best = l;
+		}
+		if (code == 16 && best >= 4) {
+			slz_stats.dc_short++;
+			slz_stats.dc_short_lost += mlen - best;
+		}
+		if (code < 16) {
+			slz_stats.dc_code[code]++;
+			slz_stats.dc_bits += fh_dist_table[dist - 1] & 0x1f;
+			if (!code && lits <= 9 && mlen <= 69)
+				slz_stats.dc_free++;
+		}
+		if (code) {
+			dc[3] = dc[2];
+			dc[2] = dc[1];
+			dc[1] = dc[0];
+			dc[0] = dist;
+		}
+	}
 }
 
 static inline void slz_stats_huff_run(const unsigned char *buf, uint32_t len, int text)
@@ -431,6 +499,31 @@ static void slz_stats_dump(void)
 		slz_stats.skips, slz_stats.skipped, PCT(slz_stats.skipped, in));
 	fprintf(stderr, "    probes     %14llu  of which %llu hits (%.2f%%)\n",
 		slz_stats.probes, slz_stats.probe_hits, PCT(slz_stats.probe_hits, slz_stats.probes));
+	{
+		unsigned long long c13 = slz_stats.dc_code[1] + slz_stats.dc_code[2] + slz_stats.dc_code[3];
+		unsigned long long c49 = 0, c1015 = 0, hits;
+		int i;
+
+		for (i = 4; i < 10; i++)
+			c49 += slz_stats.dc_code[i];
+		for (i = 10; i < 16; i++)
+			c1015 += slz_stats.dc_code[i];
+		hits = slz_stats.dc_code[0] + c13 + c49 + c1015;
+		fprintf(stderr, "  brotli distance cache (ring of the last 4 distances):\n");
+		fprintf(stderr, "    last (code 0)   %14llu  %6.2f%%, of which %llu (%.2f%%) with an implicit distance\n",
+			slz_stats.dc_code[0], PCT(slz_stats.dc_code[0], slz_stats.refs),
+			slz_stats.dc_free, PCT(slz_stats.dc_free, slz_stats.refs));
+		fprintf(stderr, "    2nd-4th (1-3)   %14llu  %6.2f%%\n", c13, PCT(c13, slz_stats.refs));
+		fprintf(stderr, "    last +-1..3     %14llu  %6.2f%%\n", c49, PCT(c49, slz_stats.refs));
+		fprintf(stderr, "    2nd +-1..3      %14llu  %6.2f%%\n", c1015, PCT(c1015, slz_stats.refs));
+		fprintf(stderr, "    total hits      %14llu  %6.2f%%, fixed tree distance bits on hits: avg %.2f, %llu bytes total\n",
+			hits, PCT(hits, slz_stats.refs), AVG(slz_stats.dc_bits, hits), slz_stats.dc_bits / 8);
+		fprintf(stderr, "      incl. switched %13llu  %6.2f%% (a cached distance gave the same length, counted above)\n",
+			slz_stats.dc_switch, PCT(slz_stats.dc_switch, slz_stats.refs));
+		fprintf(stderr, "    shorter only    %14llu  %6.2f%%, would lose %.2f bytes on avg\n",
+			slz_stats.dc_short, PCT(slz_stats.dc_short, slz_stats.refs),
+			AVG(slz_stats.dc_short_lost, slz_stats.dc_short));
+	}
 	slz_stats_hist("reference lengths", slz_stats.len_hist, 12, 1);
 	slz_stats_hist("reference distances", slz_stats.dist_hist, 16, 0);
 	slz_stats_hist("huffman literal runs", slz_stats.hrun_hist, 18, 0);
@@ -1220,7 +1313,7 @@ void text_replay(struct slz_stream *__restrict strm, const unsigned char *buf, u
 #if SLZ_STATS
 		if (vref[i].lits)
 			slz_stats_huff_run(buf, vref[i].lits, 1);
-		slz_stats_ref(vref[i].mlen, vref[i].sdist, (vref[i].code >> 16) + (vref[i].dist & 0x1f), vref[i].lits);
+		slz_stats_ref(vref[i].mlen, vref[i].sdist, (vref[i].code >> 16) + (vref[i].dist & 0x1f), vref[i].lits, buf + vref[i].lits);
 #endif
 #if !(SLZ_DRY_RUN & 1)
 		for (l = vref[i].lits; l; l--)
@@ -1332,6 +1425,7 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 #if SLZ_STATS
 	slz_stats.calls++;
 	slz_stats.in_bytes += ilen;
+	slz_stats.base = in;
 #endif
 	reset_refs(refs, sizeof(refs));
 	bal = strm->debt;
@@ -1965,7 +2059,7 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 		}
 
 #if SLZ_STATS
-		slz_stats_ref(mlen, st_dist, (code >> 16) + (dist & 0x1f), st_lits);
+		slz_stats_ref(mlen, st_dist, (code >> 16) + (dist & 0x1f), st_lits, in + pos);
 #endif
 		/* copy the length first */
 #if SLZ_DRY_RUN & 2
-- 
2.43.0

