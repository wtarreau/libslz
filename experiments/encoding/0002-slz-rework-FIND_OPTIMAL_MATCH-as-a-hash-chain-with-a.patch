(bits = average reference size, lits% = share of the input left as
literals, runlen = average literal run). Collisions and partial indexing
together cost 2.6% at 4 MB and 1.3% at 32 kB, without telling which
dominates: they mostly lose matches (3.2 and 1.6 points more of the input
left as literals). The rest of the gap to the longest match, 9.3% and
7.1%, comes from looking at a single candidate: the matches
get longer (9.05 -> 10.87) and twice as far (4142 -> 8568), so each one
costs 1.6 bits more but there are 13% fewer of them, while the share of
literals barely moves past depth 1. index.html: -1 44.42% hash, 43.06%
depth 1, 41.37% depth 2, 40.13% depth 4, 39.21% depth 16, 38.96% all.

Reproduce with:
  make zenc USR_CFLAGS="-DSLZ_STATS=1 -DFIND_OPTIMAL_MATCH=0"
  ./zenc -4 -t -v silesia.tar
---
 src/slz.c | 112 ++++++++++++++++++++++++++++++++++++------------------
 1 file changed, 74 insertions(+), 38 deletions(-)

diff --git a/src/slz.c b/src/slz.c
index 12b4550..26e2e55 100644
--- a/src/slz.c
+++ b/src/slz.c
@@ -24,6 +24,9 @@
 
 #include <stdio.h>
 #include <string.h>
+#ifdef FIND_OPTIMAL_MATCH
+#include <stdlib.h>
+#endif
 #include "slz.h"
 #include "slz-prv.h"
 #include "tables.h"
@@ -1305,6 +1308,9 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 	struct text_vref vref[SLZ_TEXT_VREFS];
 	uint32_t dist, code;
 	union ref refs[1 << SLZ_HASH_BITS];
+#ifdef FIND_OPTIMAL_MATCH
+	uint32_t *fom_prev = NULL; /* see FIND_OPTIMAL_MATCH */
+#endif
 #if SLZ_STATS
 	uint32_t st_dist = 0, st_lits;
 #endif
@@ -1324,6 +1330,27 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 	reset_refs(refs, sizeof(refs));
 	bal = strm->debt;
 
+#ifdef FIND_OPTIMAL_MATCH
+	/* chain each position to the previous one with the same hash, as
+	 * position + 1 so that 0 ends the chain.
+	 */
+	{
+		uint32_t *head = calloc(1 << 16, sizeof(*head));
+		long p;
+
+		fom_prev = malloc((ilen + 1) * sizeof(*fom_prev));
+		if (!head || !fom_prev)
+			abort();
+		for (p = 0; p + 4 <= ilen; p++) {
+			uint32_t hh = (read_le32(in + p) * 2654435761U) >> 16;
+
+			fom_prev[p] = head[hh];
+			head[hh] = p + 1;
+		}
+		free(head);
+	}
+#endif
+
 	strm->outbuf = out;
 
 #ifndef UNALIGNED_FASTER
@@ -1356,51 +1383,57 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 		}
 
 #ifdef FIND_OPTIMAL_MATCH
-		/* Experimental code to see what could be saved with an ideal
-		 * longest match lookup algorithm. This one is very slow but
-		 * scans the whole window. In short, here are the savings :
+		/* Experimental code to see what could be saved with a better
+		 * match lookup than the single entry per hash bucket. It walks
+		 * a hash chain built over the whole block on entry, retaining
+		 * the longest match within the window among the first
+		 * FIND_OPTIMAL_MATCH candidates carrying the same word (0 = all
+		 * of them), the nearest one on equal lengths. 1 is thus the
+		 * last occurrence of the word. Note that the chain indexes all
+		 * positions, including those covered by matches which the hash
+		 * table never sees, and has no collisions, so depth 1 is the
+		 * regular lookup without collisions *and* with all positions
+		 * indexed, and depth N an upper bound for N entries per bucket.
+		 * 0 is the longest match (still with greedy parsing). The
+		 * result replaces the bucket's: no match found means literal.
+		 * Old results with the window scan it replaces:
 		 *   file        orig     fast(ratio)  optimal(ratio)
 		 *  README       5185    3419 (65.9%)    3165 (61.0%)  -7.5%
 		 *  index.html  76799   35662 (46.4%)   29875 (38.9%) -16.3%
 		 *  rfc1952.c   29383   13442 (45.7%)   11793 (40.1%) -12.3%
-		 *
-		 * Thus the savings to expect for large files is at best 16%.
-		 *
-		 * A non-colliding hash gives 33025 instead of 35662 (-7.4%),
-		 * and keeping the last two entries gives 31724 (-11.0%).
 		 */
-		unsigned long scan;
-		int saved = 0;
-		int bestpos = 0;
-		int bestlen = 0;
-		int firstlen = 0;
-		int max_lookup = 2; // 0 = no limit
-
-		for (scan = pos - 1; scan < pos && (unsigned long)(pos - scan - 1) < 32768; scan--) {
-			int len;
-
-			if (*(uint32_t *)(in + scan) != word)
-				continue;
-
-			len = memmatch(in + pos, in + scan, rem);
-			if (!bestlen)
-				firstlen = len;
-
-			if (len > bestlen) {
-				bestlen = len;
-				bestpos = scan;
+		{
+			uint32_t cand = fom_prev[pos]; /* position + 1, 0 = none */
+			long fmax = rem > 258 ? 258 : rem;
+			long bestlen = 0, flen, depth = FIND_OPTIMAL_MATCH;
+			uint32_t bestpos = 0;
+
+			while (cand && pos - (cand - 1) <= 32768) {
+				uint32_t c = cand - 1;
+
+				if (read_le32(in + c) == word) {
+					/* the byte past the best length must match to beat it */
+					if (in[c + bestlen] == in[pos + bestlen]) {
+						flen = memmatch(in + pos, in + c, fmax);
+						if (flen > bestlen) {
+							bestlen = flen;
+							bestpos = c;
+							if (flen >= fmax)
+								break;
+						}
+					}
+					if (!--depth)
+						break;
+				}
+				cand = fom_prev[c];
 			}
-			if (!--max_lookup)
-				break;
-		}
-		if (bestlen) {
-			//printf("pos=%d last=%d bestpos=%d word=%08x ent=%08x len=%d\n",
-			//       (int)pos, (int)last, (int)bestpos, (int)word, (int)ent, bestlen);
-			last = bestpos;
-			ent  = word;
-			saved += bestlen - firstlen;
+			if (bestlen) {
+				last = bestpos;
+				ent  = word;
+			}
+			else
+				ent = (uint32_t)~word;
 		}
-		//fprintf(stderr, "first=%d best=%d saved_total=%d\n", firstlen, bestlen, saved);
 #endif
 
 		if ((uint32_t)ent != word) {
@@ -2048,6 +2081,9 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 		plit = 0;
 	}
  leave:
+#ifdef FIND_OPTIMAL_MATCH
+	free(fom_prev);
+#endif
 	strm->ilen += ilen;
 	return strm->outbuf - out;
 }
