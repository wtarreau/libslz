Keying on 3 bytes hurts at low depth (+8.2% on the HTML at depth 1) and
only pays when all candidates are examined: the most recent occurrence of
3 bytes is often a 3-byte match, which then shadows a longer one further
back, and greedy parsing takes it. Even with every candidate examined, 3
byte keys only save 0.15% (4 MB) and 0.60% (32 kB) of the HTML's output
over 4-byte keys, against 1.43% and 3.11% on silesia. On the HTML they do
move 2.3 points of the input from literals to references (6.66% -> 4.36%
at 4 MB), but the average match shrinks from 13.89 to 12.52 bytes and
there are 14% more references, since a short match taken greedily cuts
into a longer one starting a few bytes later. So 3-byte matches are not
worth it with a few candidates per bucket and greedy parsing, and HTML is
not where they would help.

Reproduce with:
  make zenc USR_CFLAGS="-DSLZ_STATS=1 -DFIND_OPTIMAL_MATCH=0 -DFIND_OPTIMAL_MATCH_MIN=3"
  ./zenc -4 -t -v hap-org.html
---
 src/slz.c | 42 ++++++++++++++++++++++++++++++++----------
 1 file changed, 32 insertions(+), 10 deletions(-)

diff --git a/src/slz.c b/src/slz.c
index 26e2e55..a26fb38 100644
--- a/src/slz.c
+++ b/src/slz.c
@@ -152,6 +152,11 @@ static uint32_t text_dist_table[32768];
 # define SLZ_STATS 0
 #endif
 
+/* see FIND_OPTIMAL_MATCH in slz_rfc1951_encode(): minimum match length, 3 or 4 */
+#if defined(FIND_OPTIMAL_MATCH) && !defined(FIND_OPTIMAL_MATCH_MIN)
+# define FIND_OPTIMAL_MATCH_MIN 4
+#endif
+
 /* First, RFC1951-specific declarations and extracts from the RFC.
  *
  * RFC1951 - deflate stream format
@@ -292,7 +297,7 @@ union ref {
 };
 
 #if SLZ_STATS
-/* see SLZ_STATS. Histograms: lengths 4,5,6,7,8,9-16,17-32,33-64,65-128,
+/* see SLZ_STATS. Histograms: lengths 3,4,5,6,7,8,9-16,17-32,33-64,65-128,
  * 129-257,258; distances and literal runs by power of two.
  */
 static struct {
@@ -318,7 +323,7 @@ static struct {
 	unsigned long long skipped;      /* bytes passed over by them (probed or not) */
 	unsigned long long probes;       /* words probed during a skip */
 	unsigned long long probe_hits;   /* probes which ended the skip */
-	unsigned long long len_hist[11];
+	unsigned long long len_hist[12];
 	unsigned long long dist_hist[16];
 	unsigned long long hrun_hist[18];
 	unsigned long long srun_hist[18];
@@ -338,7 +343,7 @@ static inline void slz_stats_ref(uint32_t mlen, uint32_t dist, uint32_t bits, ui
 	slz_stats.ref_dist += dist;
 	slz_stats.ref_bits += bits;
 	slz_stats.ref_adj += !lits;
-	slz_stats.len_hist[mlen <= 8 ? (int)mlen - 4 : mlen == 258 ? 10 : slz_stats_log2(mlen - 1, 7) + 2]++;
+	slz_stats.len_hist[mlen <= 8 ? (int)mlen - 3 : mlen == 258 ? 11 : slz_stats_log2(mlen - 1, 7) + 3]++;
 	slz_stats.dist_hist[slz_stats_log2(dist, 15)]++;
 }
 
@@ -363,7 +368,7 @@ static inline void slz_stats_stored_run(uint32_t len)
 
 static void slz_stats_hist(const char *name, const unsigned long long *hist, int n, int lin)
 {
-	static const char *lens[11] = { "4", "5", "6", "7", "8", "9-16", "17-32", "33-64", "65-128", "129-257", "258" };
+	static const char *lens[12] = { "3", "4", "5", "6", "7", "8", "9-16", "17-32", "33-64", "65-128", "129-257", "258" };
 	unsigned long long tot = 0;
 	int i;
 
@@ -426,7 +431,7 @@ static void slz_stats_dump(void)
 		slz_stats.skips, slz_stats.skipped, PCT(slz_stats.skipped, in));
 	fprintf(stderr, "    probes     %14llu  of which %llu hits (%.2f%%)\n",
 		slz_stats.probes, slz_stats.probe_hits, PCT(slz_stats.probe_hits, slz_stats.probes));
-	slz_stats_hist("reference lengths", slz_stats.len_hist, 11, 1);
+	slz_stats_hist("reference lengths", slz_stats.len_hist, 12, 1);
 	slz_stats_hist("reference distances", slz_stats.dist_hist, 16, 0);
 	slz_stats_hist("huffman literal runs", slz_stats.hrun_hist, 18, 0);
 	slz_stats_hist("stored literal runs", slz_stats.srun_hist, 18, 0);
@@ -1310,6 +1315,7 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 	union ref refs[1 << SLZ_HASH_BITS];
 #ifdef FIND_OPTIMAL_MATCH
 	uint32_t *fom_prev = NULL; /* see FIND_OPTIMAL_MATCH */
+# define FOM_MASK (FIND_OPTIMAL_MATCH_MIN == 3 ? 0xffffffu : 0xffffffffu)
 #endif
 #if SLZ_STATS
 	uint32_t st_dist = 0, st_lits;
@@ -1342,7 +1348,7 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 		if (!head || !fom_prev)
 			abort();
 		for (p = 0; p + 4 <= ilen; p++) {
-			uint32_t hh = (read_le32(in + p) * 2654435761U) >> 16;
+			uint32_t hh = ((read_le32(in + p) & FOM_MASK) * 2654435761U) >> 16;
 
 			fom_prev[p] = head[hh];
 			head[hh] = p + 1;
@@ -1394,8 +1400,12 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 		 * table never sees, and has no collisions, so depth 1 is the
 		 * regular lookup without collisions *and* with all positions
 		 * indexed, and depth N an upper bound for N entries per bucket.
-		 * 0 is the longest match (still with greedy parsing). The
-		 * result replaces the bucket's: no match found means literal.
+		 * 0 is the longest match (still with greedy parsing). With
+		 * FIND_OPTIMAL_MATCH_MIN set to 3, the chain is keyed on 3
+		 * bytes and 3-byte matches are taken when they cost less than
+		 * their literals (fixed tree only, the text tree has no code
+		 * for them). The result replaces the bucket's: no match found
+		 * means literal.
 		 * Old results with the window scan it replaces:
 		 *   file        orig     fast(ratio)  optimal(ratio)
 		 *  README       5185    3419 (65.9%)    3165 (61.0%)  -7.5%
@@ -1411,7 +1421,7 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 			while (cand && pos - (cand - 1) <= 32768) {
 				uint32_t c = cand - 1;
 
-				if (read_le32(in + c) == word) {
+				if (((read_le32(in + c) ^ word) & FOM_MASK) == 0) {
 					/* the byte past the best length must match to beat it */
 					if (in[c + bestlen] == in[pos + bestlen]) {
 						flen = memmatch(in + pos, in + c, fmax);
@@ -1427,7 +1437,7 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 				}
 				cand = fom_prev[c];
 			}
-			if (bestlen) {
+			if (bestlen >= FIND_OPTIMAL_MATCH_MIN) {
 				last = bestpos;
 				ent  = word;
 			}
@@ -1650,7 +1660,19 @@ long _slz_rfc1951_encode(struct slz_stream *__restrict strm, unsigned char *out,
 		lastp = in + last;
 
 		/* Note: cannot encode a length larger than 258 bytes */
+#if defined(FIND_OPTIMAL_MATCH) && FIND_OPTIMAL_MATCH_MIN == 3
+		mlen = memmatch(in + pos + 3, lastp + 3, (rem > 258 ? 258 : rem) - 3) + 3;
+
+		/* only when cheaper than its literals, see FIND_OPTIMAL_MATCH */
+		if (mlen == 3) {
+			if (ctype == SLZ_CT_TEXT ||
+			    (len_fh[3] >> 16) + (fh_dist_table[pos - last - 1] & 0x1f) >=
+			    24U + (in[pos] >= 144) + (in[pos + 1] >= 144) + (in[pos + 2] >= 144))
+				goto send_as_lit;
+		}
+#else
 		mlen = memmatch(in + pos + 4, lastp + 4, (rem > 258 ? 258 : rem) - 4) + 4;
+#endif
 
 		/* found a matching entry */
 
