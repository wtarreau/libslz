diff --git a/src/slz.c b/src/slz.c
index 210f2ab..b8d98d1 100644
--- a/src/slz.c
+++ b/src/slz.c
@@ -1126,6 +1126,40 @@ static inline int text_lit_stored(const struct slz_stream *strm, int32_t excess)
 	        (int32_t)strm->text_debt + excess >= SLZ_TEXT_MAX_DEBT);
 }
 
+/* Experimental: SLZ_TEXT_LAZY makes the text tree's encoder of levels 3 and
+ * above count <lit_excess> at each match from the literals not counted yet
+ * instead of one at a time, and check for binary data every 64 literals by
+ * the number of bytes >= 0x80 among them, at least SLZ_TEXT_LAZY.
+ */
+#ifndef SLZ_TEXT_LAZY
+# define SLZ_TEXT_LAZY 0
+#endif
+
+/* returns the cost of the <n> bytes at <p> with the text tree, relative to 8
+ * bits each.
+ */
+static inline int32_t text_excess(const unsigned char *p, unsigned long n)
+{
+	int32_t x = 0;
+
+	while (n--)
+		x += (int32_t)(text_huff[*p++] & 15) - 8;
+	return x;
+}
+
+/* returns the number of bytes >= 0x80 among the 64 at <p> */
+static inline uint32_t high_bytes64(const unsigned char *p)
+{
+	uint64_t a = 0, w;
+	int i;
+
+	for (i = 0; i < 64; i += 8) {
+		memcpy(&w, p + i, 8);
+		a += (w >> 7) & 0x0101010101010101ULL;
+	}
+	return (a * 0x0101010101010101ULL) >> 56;
+}
+
