+/* hash log for experiments/hash, see the README there */
+#include <stdio.h>
+#include <stdlib.h>
+static FILE *slz_hlog;
+static const unsigned char *slz_hbase;
+/* logs <a> read at <p>, of kind <t> (0 lookup, 1 insert, 2 probe) */
+static inline uint32_t slz_hash_log(uint32_t a, const unsigned char *p, int t)
+{
+	static int done;
+	uint32_t r[3];
+
+	if (!done) {
+		const char *n = getenv("SLZ_HLOG");
+
+		done = 1;
+		slz_hlog = n ? fopen(n, "w") : NULL;
+		slz_hbase = p; /* zenc maps the whole input, offsets are relative to it */
+	}
+	if (slz_hlog) {
+		r[0] = a; r[1] = (uint32_t)(p - slz_hbase); r[2] = t;
+		fwrite(r, sizeof(r), 1, slz_hlog);
+	}
+	return slz_hash(a);
+}
