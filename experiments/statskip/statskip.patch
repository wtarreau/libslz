+/* Experimental (experiments/statskip): SLZ_STAT_SKIP makes the literal skip of
+ * levels 1 and 2 depend on statistics of the 64 bytes just scanned, so that it
+ * only engages on random-looking data. Bits:
+ *   1: level 1: a skip step is only taken when the chunk looks random;
+ *   2: no ramp: when it looks random, the step is immediately the largest
+ *      one (levels 1 and 2);
+ *   4: level 1: each 64-byte chunk of a step is checked too, and the step
+ *      stops on the first one that doesn't look random;
+ *   8: level 2: same as 1. Without it, level 2 keeps its usual skip on
+ *      chunks that don't look random.
+ *  16: Willy's byte mode (levels 1 and 2), replacing all of the above: once
+ *      64 literals are pending, the following bytes are walked one by one
+ *      without any lookup, feeding avg = avg - (avg + 255) / 256 + x
+ *      (preset to 128 * 256) and mad = mad - (mad + 255) / 256 + |x - avg/256|
+ *      (preset to 64 * 256, the mean absolute deviation of random bytes).
+ *      The walk stops as soon as avg leaves 128 +/- SLZ_STAT_T or mad falls
+ *      below SLZ_STAT_M, and the main loop resumes SLZ_STAT_LAG bytes before
+ *      that point, since the averages take a few tens of bytes to react. The
+ *      bytes walked over are sent as literals (stored block).
+ *  64: with 16, the walk reads 8 bytes at a time, feeding their sum to the
+ *      average with 1/32 per step (same steady state), and ignores mad.
+ * 128: change detection in the skip steps of levels 1 and 2, see
+ *      slz_chunk_changed() (not with 16).
+ *  32: with 16, also on the text tree, where the walked bytes are charged
+ *      their exact cost in <lit_excess>, so that the usual decision sends
+ *      them in a stored block when they are not text.
+ * SLZ_STAT_FN picks the test:
+ *   1: mean within 128 +/- 16 (SWAR sum);
+ *   2: at least 52 distinct byte values;
+ *   3: mean within 128 +/- 16 and at most 2 bytes equal to the one 1, 2 or
+ *      4 positions before;
+ *   4: Willy's moving average avg = avg - avg/256 + x fed with the checked
+ *      chunks, within 128 +/- 8.
+ */
+#ifndef SLZ_STAT_SKIP
+# define SLZ_STAT_SKIP 0
+#endif
+#ifndef SLZ_STAT_FN
+# define SLZ_STAT_FN 1
+#endif
+#ifndef SLZ_STAT_T
+# define SLZ_STAT_T 16
+#endif
+#ifndef SLZ_STAT_M
+# define SLZ_STAT_M 48
+#endif
+#ifndef SLZ_STAT_LAG
+# define SLZ_STAT_LAG 64
+#endif
+/* time constant of the byte mode's averages: 1 << SLZ_STAT_SHIFT samples
+ * (8 = 256 as in Willy's formula, 6 = 64). The 8-byte walk needs >= 3.
+ */
+#ifndef SLZ_STAT_SHIFT
+# define SLZ_STAT_SHIFT 8
+#endif
+
+/* SLZ_STAT_SKIP & 128 (levels 1 and 2): change detection. Each 64-byte chunk
+ * of a skip step is summarized by the sum of its bytes and the number of
+ * bytes >= 0x80, and compared with a running reference of the chunks before
+ * it (preset from the last 64 bytes scanned, then ref = ref - ref/4 + cur).
+ * When the mean differs by more than SLZ_CHG_M or the count by more than
+ * SLZ_CHG_H, the data changed type: the step stops at the start of that
+ * chunk and the ramp restarts from zero. Level 1 gets a chunk loop for it,
+ * level 2 adds it to its probes.
+ */
+#ifndef SLZ_CHG_M
+# define SLZ_CHG_M 24
+#endif
+#ifndef SLZ_CHG_H
+# define SLZ_CHG_H 12
+#endif
+/* 1 = keep the ramp after a change instead of restarting it */
+#ifndef SLZ_CHG_KEEP
+# define SLZ_CHG_KEEP 0
+#endif
+
+#if SLZ_STAT_SKIP & 128
+static inline void slz_chunk_stats(const unsigned char *p, uint32_t *sum, uint32_t *hib)
+{
+	uint64_t a = 0;
+	uint32_t h = 0;
+	int i;
+
+	for (i = 0; i < 64; i += 8) {
+		uint64_t w;
+
+		memcpy(&w, p + i, 8);
+		a += (w & 0x00ff00ff00ff00ffULL) + ((w >> 8) & 0x00ff00ff00ff00ffULL);
+		h += __builtin_popcountll(w & 0x8080808080808080ULL);
+	}
+	*sum = (a * 0x0001000100010001ULL) >> 48;
+	*hib = h;
+}
+
+/* returns non-zero if the chunk at <p> differs from the reference, otherwise
+ * updates the reference.
+ */
+static inline int slz_chunk_changed(const unsigned char *p, uint32_t *rs, uint32_t *rh)
+{
+	uint32_t cs, ch;
+	int32_t ds, dh;
+
+	slz_chunk_stats(p, &cs, &ch);
+	ds = (int32_t)(4 * cs) - (int32_t)*rs;
+	dh = (int32_t)(4 * ch) - (int32_t)*rh;
+	if ((ds < 0 ? -ds : ds) > 4 * 64 * SLZ_CHG_M || (dh < 0 ? -dh : dh) > 4 * SLZ_CHG_H)
+		return 1;
+	*rs += cs - *rs / 4;
+	*rh += ch - *rh / 4;
+	return 0;
+}
+#endif
+
+/* SLZ_SKIP_PLIT: derive the skip ramp of levels 1 and 2 from <plit> instead
+ * of keeping <skip_ratio>, which is then neither kept nor reset on matches.
+ * SLZ_SKIP_PLIT=2 does the same at level 3 with its own ramp.
+ * SLZ_SKIP_OOL: implies SLZ_SKIP_PLIT, and moves the skip step (the probes
+ * of level 2) to slz_skip_step(), out of the encoder's loop.
+ */
+#ifndef SLZ_SKIP_OOL
+# define SLZ_SKIP_OOL 0
+#endif
+#ifndef SLZ_SKIP_PLIT
+# define SLZ_SKIP_PLIT SLZ_SKIP_OOL
+#endif
+
+#if SLZ_SKIP_OOL
+/* Skips up to <skip> bytes at <pos> (a multiple of 64 unless limited by the
+ * end), probing and indexing the last word of each 64-byte chunk at level 2
+ * and stopping at the start of the first chunk whose word is already in the
+ * window. Returns the number of bytes skipped.
+ */
+static __attribute__((noinline))
+long slz_skip_step(union ref *refs, const unsigned char *in, unsigned long pos, long skip, int level)
+{
+	unsigned long start = pos;
+	long chunks;
+
+	if (level != 2 || skip < 64)
+		return skip;
+
+	chunks = skip >> 6;
+	do {
+		uint32_t w = read_le32(in + pos + 60);
+		uint32_t hw = slz_hash(w);
+
+		if (sizeof(long) >= 8) {
+			uint64_t old = refs[hw].by64;
+
+			if ((uint32_t)(old >> 32) == w && (unsigned long)(pos + 59 - (uint32_t)old) < 32768)
+				return pos - start;
+			refs[hw].by64 = ((uint64_t)(pos + 60)) + ((uint64_t)w << 32);
+		} else {
+			if (refs[hw].by32.word == w && (unsigned long)(pos + 59 - refs[hw].by32.pos) < 32768)
+				return pos - start;
+			refs[hw].by32.pos = pos + 60;
+			refs[hw].by32.word = w;
+		}
+		pos += 64;
+	} while (--chunks);
+	return pos - start + (skip & 63);
+}
+#endif
+
+#if SLZ_STAT_SKIP
+static inline int slz_looks_random(const unsigned char *p, uint32_t *ewma)
+{
+#if SLZ_STAT_FN == 1 || SLZ_STAT_FN == 3
+	uint64_t a = 0, z = 0;
+	int i;
+
+	for (i = 0; i < 64; i += 8) {
+		uint64_t w;
+
+		memcpy(&w, p + i, 8);
+		a += (w & 0x00ff00ff00ff00ffULL) + ((w >> 8) & 0x00ff00ff00ff00ffULL);
+#if SLZ_STAT_FN == 3
+		{
+			uint64_t v1 = w ^ (w >> 8), v2 = w ^ (w >> 16), v4 = w ^ (w >> 32);
+			const uint64_t o = 0x0101010101010101ULL, h = 0x8080808080808080ULL;
+
+			z += __builtin_popcountll(((v1 - o) & ~v1 & h) & 0x0080808080808080ULL);
+			z += __builtin_popcountll(((v2 - o) & ~v2 & h) & 0x0000808080808080ULL);
+			z += __builtin_popcountll(((v4 - o) & ~v4 & h) & 0x0000000080808080ULL);
+		}
+#endif
+	}
+	a = (a * 0x0001000100010001ULL) >> 48;
+	(void)ewma;
+	return (a - (8160 - 1024)) <= 2048 && z <= 2;
+#elif SLZ_STAT_FN == 2
+	uint64_t m[4] = { 0, 0, 0, 0 };
+	int i;
+
+	(void)ewma;
+	for (i = 0; i < 64; i++)
+		m[p[i] >> 6] |= 1ULL << (p[i] & 63);
+	return __builtin_popcountll(m[0]) + __builtin_popcountll(m[1]) +
+	       __builtin_popcountll(m[2]) + __builtin_popcountll(m[3]) >= 52;
+#else
+	uint32_t e = *ewma;
+	int i;
+
+	for (i = 0; i < 64; i++)
+		e = e - ((e + 255) >> 8) + p[i];
+	*ewma = e;
+	/* e converges to about 256 * mean */
+	return (uint32_t)(e - (128 - 8) * 256) <= 16 * 256;
+#endif
+}
+#endif
+
