+/* Experimental: SLZ_AUTO_TREE chooses the huffman tree on the fly, within
+ * a call, between the fixed one and the text one, unless the text tree was
+ * forced with slz_set_content_type(). The literals sent with a tree are
+ * compared to what the other tree would have cost them, and the difference
+ * is accumulated in <auto_save> (a CUSUM, never below zero). Literals sent
+ * as a stored block with the fixed tree reset it (binary data). With the text
+ * tree, the encoder accounts each group of literals with its <lit_excess>,
+ * i.e. as if the fixed tree took 8 bits for each, whether they are sent with
+ * the tree or as a stored block. Above
+ * SLZ_AUTO_IN bits (fixed -> text) or SLZ_AUTO_OUT bits (text -> fixed), the
+ * encoder switches after the next match: it closes the current block, and
+ * the encoder for the other tree, which shares the same reference table,
+ * continues from there. This is all done
+ * outside of the encoder's loop, in the functions that send the literals.
+ * SLZ_AUTO_TLEVEL forces the level of the text tree's encoder (0: same as
+ * the fixed one).
+ */
+#ifndef SLZ_AUTO_TREE
+# define SLZ_AUTO_TREE 0
+#endif
+#ifndef SLZ_AUTO_IN
+# define SLZ_AUTO_IN 1280
+#endif
+#ifndef SLZ_AUTO_OUT
+# define SLZ_AUTO_OUT 256
+#endif
+#ifndef SLZ_AUTO_TLEVEL
+# define SLZ_AUTO_TLEVEL 0
+#endif
+
+#if SLZ_AUTO_TREE
+/* accounts <d> more bits that the other tree would have saved on literals
+ * sent with <ctype>, and requests a switch past the threshold.
+ */
+static inline void auto_account(struct slz_stream *__restrict strm, int32_t d, int ctype)
+{
+	int32_t s = strm->auto_save + d;
+
+	if (s < 0)
+		s = 0;
+	if (s > (ctype == SLZ_CT_TEXT ? SLZ_AUTO_OUT : SLZ_AUTO_IN)) {
+		strm->auto_sw = 1;
+		s = 0;
+	}
+	strm->auto_save = s;
+}
+
+/* bits saved by the text tree over the fixed one on byte <c> */
+static inline int32_t auto_tdelta(unsigned char c)
+{
+	return (int32_t)(fixed_huff[c] & 15) - (int32_t)(text_huff[c] & 15);
+}
+#endif
