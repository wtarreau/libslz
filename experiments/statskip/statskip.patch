+/* Debugging aid for the skip studies (experiments/statskip): with
+ * -DSLZ_TRACE, writes one 16-byte record per event to fd 3: a type ('M' for
+ * a match, 'S' for a skip step), the absolute input position (64 bits),
+ * and a length (32 bits): the match length in bits 0-15 and the number of
+ * bits of its distance code in bits 16-20, or the number of bytes skipped
+ * with bit 31 set when the skip was stopped by a hit.
+ */
+#ifdef SLZ_TRACE
+static void slz_trace(int type, unsigned long pos, uint32_t len)
+{
+	static FILE *f;
+	struct { uint32_t type, len; uint64_t pos; } rec = { type, len, pos };
+
+	if (!f)
+		f = fdopen(3, "w");
+	if (f)
+		fwrite(&rec, sizeof(rec), 1, f);
+}
+# define SLZ_TRACE_EV(t, p, l) slz_trace(t, strm->ilen + (p), l)
+# define SLZ_TRACE_DO(x) x
+#else
+# define SLZ_TRACE_EV(t, p, l) do { } while (0)
+# define SLZ_TRACE_DO(x)
+#endif
