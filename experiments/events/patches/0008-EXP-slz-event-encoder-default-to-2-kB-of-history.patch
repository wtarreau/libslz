From 32014a74d633c8a92417be927d35574f70de98ad Mon Sep 17 00:00:00 2001
From: Willy Tarreau <w@1wt.eu>
Date: Sun, 15 Nov 2026 15:30:31 +0100
Subject: [PATCH 08/11] EXP: slz: event encoder: default to 2 kB of history

2 kB with 4-byte tagged entries on 9 bits, step 8, prefetched table: the
balanced point (SSE 4.05%, logs 21-37%), 4.5 kB per stream.
---
 src/slz.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/slz.h b/src/slz.h
index f965c73..a9ce3bc 100644
--- a/src/slz.h
+++ b/src/slz.h
@@ -125,7 +125,7 @@ struct slz_stream {
 # define SLZ_EV_HASH_BITS 9
 #endif
 #ifndef SLZ_EV_HIST
-# define SLZ_EV_HIST 512
+# define SLZ_EV_HIST 2048
 #endif
 
 struct slz_ev_ctx {
